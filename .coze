[project]
requires = ["nodejs-24"]

[dev]
build = ["bash", "-c", "cd backend && pnpm install && cd ../frontend && pnpm install"]
run = ["bash", "-c", "cd backend && (pnpm run dev > /app/work/logs/bypass//backend.log 2>&1 &) && sleep 2 && cd ../frontend && pnpm run dev"]

[deploy]
build = ["bash", "-c", "cd backend && pnpm install && pnpm run build && cd ../frontend && pnpm install && pnpm run build"]
run = ["bash", "-c", "cd backend && (NODE_ENV=production node dist/index.js > /app/work/logs/bypass//backend.log 2>&1 &) && sleep 1 && cd ../frontend && npx serve -s dist -l ${DEPLOY_RUN_PORT}"]
